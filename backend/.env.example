# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file.

# ── Gemini LLM ───────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── LLM Provider: "gemini" is the only supported option for now ──
LLM_PROVIDER=gemini

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dataset ──────────────────────────────────────────────────
# Path to the cached CSV (relative to backend/)
DATASET_CACHE_PATH=data/zomato_processed.csv

# Hugging Face dataset identifier
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for all origins.
# In production, set this to your Vercel frontend URL, e.g., https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=*
